#!/bin/bash
# Shairport Sync as an OpenFrame service: nqptp, AirPlay 2's clock, and shairport-sync together.
#
# nqptp alone holds the right to open low ports (the service's lowports, for PTP's 319 and 320): it's started first, and then this script runs itself again without that right (setpriv), for everything else: working out the settings, amixer, shairport-sync, and watching. If either program ends, so does the service, and the helper starts it again.
#
# shairport-sync's settings are written afresh into $HOME (the service's own folder) as it starts, and again whenever what they're made from changes: the OpenFrame's name as written in Settings, under About (/etc/machine-info, from openframe-scripts), and where its sound goes (/etc/asound.conf, from of-audio). Then shairport-sync alone starts again, the new way, rather than the service failing and being restarted (which the helper allows only five times in ten minutes).
#
#   shairport-sync-service            the service
#   shairport-sync-service --config   only write the settings (test.sh)
D=/usr/lib/ofapp-shairport-sync
ASOUND=/etc/asound.conf
INFO=${OF_MACHINE_INFO:-/etc/machine-info}

# A value in shairport-sync's settings, in double quotes: libconfig's \ and " escaped; ${ written as $${, as shairport-sync otherwise reads ${NAME} as an environment variable (and stops if there's none); and %h, %H, %v and %V, which it puts the hostname or its version in place of (in the name), broken with a zero-width space, as there's no escape for them
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\${/$${/g; s/%\([hHvV]\)/%\xe2\x80\x8b\1/g'; }

# What the settings are made from, to see it change (cksum of the files, not of a redirect: a missing file's error would be logged at every look)
sources() { cksum "$ASOUND" "$INFO" 2>/dev/null; }

write_config() {
	local name general_vol alsa_vol card control c n names=()
	name=$(sed -n 's/^PRETTY_HOSTNAME=//p' "$INFO" 2>/dev/null | sed 's/^"\(.*\)"$/\1/; s/\\\(.\)/\1/g')
	[ -n "$name" ] || name=OpenFrame
	# The volume. Mixed (the speaker, or a DAC whose volume the OpenFrame sets), the sender's volume is the OpenFrame's: shairport-sync sets the card's own volume control (the one Settings and the status bar set, found as of-audio finds it: Master, PCM, Speaker or Headphone, else the first with a volume, which is of-audio's software one, OpenFrame, on a DAC with none of its own) and leaves the sound as it is. Direct to a DAC (ALSA's default is the DAC itself), the sender's volume is ignored altogether, so nothing changes the sound on its way. Without a control to set (someone's own asound.conf, say), shairport-sync's own volume.
	general_vol='ignore_volume_control = "yes";' alsa_vol=""
	if ! grep -q '^[[:space:]]*slave\.pcm "hw:' "$ASOUND" 2>/dev/null; then
		general_vol=""
		card=$(sed -n 's/^[[:space:]]*card "\(.*\)"$/\1/p' "$ASOUND" 2>/dev/null | tail -1)
		# (amixer with no home: ALSA reads ~/.asoundrc, and this one's would be shairport-sync's own folder)
		mapfile -t names < <(HOME=/nonexistent amixer ${card:+-c "$card"} scontrols 2>/dev/null | sed -n "s/^Simple mixer control '\(.*\)',0$/\1/p")
		control=""
		for c in Master PCM Speaker Headphone "${names[@]}"; do
			for n in "${names[@]}"; do
				[ "$n" = "$c" ] && HOME=/nonexistent amixer ${card:+-c "$card"} sget "$n" 2>/dev/null | grep -q '^  Capabilities:.*pvolume' && { control=$n; break 2; }
			done
		done
		[ -n "$control" ] && alsa_vol="mixer_control_name = \"$(esc "$control")\";${card:+ mixer_device = \"hw:$(esc "$card")\";}"
	fi
	# The sound to ALSA's default; what's playing, with its artwork, to the OpenFrame's interface (metadata over UDP on this OpenFrame only), with a heartbeat while playing (progress_interval: phbt), so the interface knows a session's gone if shairport-sync is
	cat > "$HOME/shairport-sync.conf.new" <<CONF
general = { name = "$(esc "$name")"; output_backend = "alsa"; $general_vol };
alsa = { output_device = "default"; $alsa_vol };
metadata = { enabled = "yes"; include_cover_art = "yes"; socket_address = "127.0.0.1"; socket_port = 5555; socket_msglength = 65000; progress_interval = 5.0; };
CONF
	mv -f "$HOME/shairport-sync.conf.new" "$HOME/shairport-sync.conf"
}

if [ "$1" = --config ]; then
	write_config
	exit 0
fi

# The first run: nqptp, with the right to low ports, then the rest without it
if [ "$1" != --without-lowports ]; then
	"$D/nqptp" &
	exec setpriv --inh-caps=-all --ambient-caps=-all /bin/bash "$0" --without-lowports "$!"
fi
nqptp=$2

seen=$(sources)
write_config
"$D/shairport-sync" -c "$HOME/shairport-sync.conf" &
sps=$!
while sleep 5; do
	kill -0 "$nqptp" 2>/dev/null || { echo "nqptp has stopped"; break; }
	kill -0 "$sps" 2>/dev/null || { echo "shairport-sync has stopped"; break; }
	now=$(sources)
	[ "$now" = "$seen" ] && continue
	# The name, or where the sound goes, has changed: shairport-sync again, the new way (nqptp carries on)
	seen=$now
	kill "$sps" 2>/dev/null
	wait "$sps" 2>/dev/null
	write_config
	"$D/shairport-sync" -c "$HOME/shairport-sync.conf" &
	sps=$!
done
kill "$sps" "$nqptp" 2>/dev/null
exit 1
